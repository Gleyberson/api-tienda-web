<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
  <script src="/socket.io/socket.io.js" defer></script>
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg bg-white border-bottom mb-4">
    <div class="container">
      <a class="navbar-brand" href="/home">Tienda</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/home">Home</a>
        <a class="nav-link" href="/products">Productos</a>
        <a class="nav-link" href="/realtimeproducts">Real-time</a>
        <a id="navCart" class="nav-link d-none" href="#">Ver carrito</a>
      </div>
    </div>
  </nav>

  <main class="container pb-5">
    {{{body}}}
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Mostrar "Ver carrito" si existe un cid en localStorage
    (function() {
      try {
        var cid = localStorage.getItem('cid');
        var link = document.getElementById('navCart');
        if (cid && link) {
          link.href = '/carts/' + cid + '/view';
          link.classList.remove('d-none');
        }
      } catch (_) {}
    })();
  </script>
</body>
</html>